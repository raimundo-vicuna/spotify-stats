# Spotify Developer Dashboard
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
CALLBACK_URL=http://localhost:3000/auth/spotify/callback

# MongoDB Atlas. URL-encode special characters in the password.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>/<database>?retryWrites=true&w=majority

# Long, random session signing secret. SECRET_KEY is also accepted for compatibility.
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
NODE_ENV=development
